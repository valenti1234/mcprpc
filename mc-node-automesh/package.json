{
  "name": "mcprpc",
  "version": "0.1.0",
  "description": "AutoMesh for Node.js - automatically expose Node.js functions as MCP tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/valenti/mcprpc.git",
    "directory": "mc-node-automesh"
  },
  "homepage": "https://github.com/valenti/mcprpc/tree/main/mc-node-automesh",
  "bugs": {
    "url": "https://github.com/valenti/mcprpc/issues"
  },
  "keywords": [
    "mcp",
    "mcprpc",
    "automesh",
    "registry",
    "router"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "mcprpc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts",
    "test": "vitest run",
    "dev": "tsx examples/billing-worker.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
